{
  "name": "dsh-plugin-git-command",
  "version": "0.1.0",
  "description": "把 /commit、/push、/commit-push 注入会话，按配置的格式提交与推送代码。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "src",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "git",
    "commit",
    "push"
  ],
  "author": "adoleiiiiii",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rh666666/dsh-plugin-git-command.git"
  },
  "homepage": "https://github.com/rh666666/dsh-plugin-git-command#readme",
  "bugs": {
    "url": "https://github.com/rh666666/dsh-plugin-git-command/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
